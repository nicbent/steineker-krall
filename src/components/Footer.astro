---
import {consentDefaults} from '../lib/consentDefaults'
import {getContent, type Settings} from '../lib/content'

interface Props {
  settings: Settings
}

const {settings} = Astro.props
const {consent} = await getContent()
const consentActive = Boolean(consent?.enabled && consent?.analyticsId)
const consentLabel = (consent?.footerLinkLabel as string | undefined)?.trim() || consentDefaults.footerLinkLabel
const tel = settings.phone?.replace(/\(0\)|[^\d+]/g, '')
---

<footer data-tone="dark" class="theme-dark pt-10 pb-4">
  <div class="container">
  <div class="grid gap-10 lg:grid-cols-[10fr_10fr_4fr] lg:gap-0">
    {
      settings.socialText && (
        <p class="text-lead lg:max-w-[11em]">
          {settings.socialText}{' '}
          {settings.socialUrl && (
            <a href={settings.socialUrl} class="link-underline">
              {settings.socialLabel}
            </a>
          )}
        </p>
      )
    }
    <p class="lg:max-w-[13em]">
      Kontakt<br />
      {settings.phone && <>Telefon: <a href={`tel:${tel}`} class="hover:underline">{settings.phone}</a><br /></>}
      {settings.email && <>E-Mail: <a href={`mailto:${settings.email}`} class="hover:underline">{settings.email}</a></>}
    </p>
    <p>
      Adresse<br />
      {settings.street}<br />
      {settings.city}
    </p>
  </div>

  <div class="mt-16 text-center lg:mt-28">
    <ul class="flex justify-center gap-5">
      {
        settings.legalLinks?.map((link) => (
          <li>
            <a href={link.href} class="link-underline">
              {link.label}
            </a>
          </li>
        ))
      }
      {
        // Zustimmung jederzeit ändern (Pflicht, sobald der Banner aktiv ist)
        consentActive && (
          <li>
            <button type="button" class="link-underline" data-cc="show-preferencesModal">
              {consentLabel}
            </button>
          </li>
        )
      }
    </ul>
    <p class="mt-3 text-small">© {new Date().getFullYear()} {settings.copyright}</p>
  </div>
  </div>
</footer>
