---
import type {Page} from '../lib/content'
import {heroOverlay} from '../lib/heroOverlay'
import ArrowLink from './ArrowLink.astro'
import Img from './Img.astro'

interface Props {
  hero: NonNullable<Page['hero']>
  /** Hat die Seite ein Intro, trägt dieses die H1; der Hero-Titel wird dann kein H1 */
  titleTag?: 'h1' | 'p'
}

const {hero, titleTag = 'h1'} = Astro.props
const Title = titleTag
const full = hero.size === 'full'
const center = hero.align === 'center'
const hasText = Boolean(hero.title || hero.eyebrow || hero.lead || (hero.link?.href && hero.link.label))
const overlay = heroOverlay(hero.overlay)
// Mittiger Text: gleichmäßige Abdunklung statt Verlauf von unten (bei „Stark“ etwa wie beim Banner)
const base = center && hasText ? Math.max(overlay.base, overlay.bottom * 0.6) : overlay.base
const bottom = center || !hasText ? 0 : overlay.bottom
---

<section
  data-tone="dark"
  class:list={[
    'relative flex overflow-hidden bg-ink text-white',
    center ? 'items-center' : 'items-end',
    full ? 'min-h-svh' : 'min-h-[50svh]',
  ]}
>
  {hero.image && <Img image={hero.image} eager class="absolute inset-0 h-full w-full object-cover" />}
  {
    // Video über dem Bild; das Bild bleibt Vorschau und Ersatz bei „Bewegung reduzieren“
    hero.video && (
      <video
        class="hero-video absolute inset-0 h-full w-full object-cover"
        data-src={hero.video}
        poster={hero.image?.url}
        muted
        loop
        playsinline
        preload="none"
        data-lazy-video
        aria-hidden="true"
      />
    )
  }
  {
    // Abdunklung aus dem Studio: Grundton über dem ganzen Bild, dazu ein Verlauf von unten (nur mit Text)
    (base > 0 || bottom > 0) && (
      <div
        class="hero-overlay absolute inset-0"
        style={`--base: ${base}; --bottom: ${bottom}`}
        aria-hidden="true"
      />
    )
  }
  {
    hasText && (
      <>
        {/* Gleicher Seitenabstand wie Logo und Menü im Header */}
        <div class:list={['relative w-full px-4 lg:px-[3vw]', center ? 'py-24 text-center' : 'pb-12 lg:pb-16']}>
          {hero.eyebrow && <p class="text-lead" data-reveal>{hero.eyebrow}</p>}
          {hero.title && (
            <Title class:list={['hero-title mt-2 max-w-4xl font-bold text-balance', center && 'mx-auto']} data-reveal>
              {hero.title}
            </Title>
          )}
          {hero.lead && (
            <p class:list={['mt-4 max-w-2xl text-lead text-balance', center && 'mx-auto']} data-reveal>
              {hero.lead}
            </p>
          )}
          <ArrowLink link={hero.link} />
        </div>
      </>
    )
  }
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
  }
  .hero-overlay {
    background:
      linear-gradient(to top, rgb(29 27 27 / var(--bottom)) 0%, rgb(29 27 27 / calc(var(--bottom) * 0.2)) 55%, transparent 100%),
      rgb(29 27 27 / var(--base));
  }
  /* Größer als die H1-Stufe der Skala: Der Titel ist die Aussage der Seite */
  .hero-title {
    font-size: clamp(1.75rem, 1.1rem + 2.4vw, 3.25rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
</style>
