<style is:global>
  .sk-logo {
    --h: 48px;                       /* Höhe des Logos */
    --ease: cubic-bezier(.65,0,.2,1);
    display: inline-block;
    height: var(--h);
    width: calc(var(--h) * 3800 / 540);
    overflow: hidden;
    color: inherit;
    line-height: 0;
    transition: width .5s var(--ease) 0s;
  }
  .sk-logo__svg { display: block; height: 100%; width: calc(var(--h) * 3800 / 540); overflow: visible; }
  .sk-logo__rest path,
  .sk-logo__s, .sk-logo__k, .sk-logo__mono { transform-box: fill-box; }

  /* Ausgangszustand: voller Schriftzug */
  .sk-logo__rest path {
    transform-origin: center;
    transition: opacity .35s ease calc(500ms + 220ms - var(--d)),
                transform .45s var(--ease) calc(500ms + 220ms - var(--d));
  }
  .sk-logo__s, .sk-logo__k {
    transform-origin: 0 0;
    transition: transform .6s var(--ease) .1s, opacity .2s ease 0s;
  }
  .sk-logo__mono {
    opacity: 0;
    transform-origin: center;
    transform: scale(.94);
    transition: opacity .2s ease 0s, transform .4s var(--ease) 0s;
  }

  /* Kompakt: nur SK */
  .sk-logo.is-compact { width: calc(var(--h) * 877.8 / 540); transition-delay: .35s; }
  .sk-logo.is-compact .sk-logo__rest path {
    opacity: 0;
    transform: translateY(-35%);
    transition-delay: var(--d), var(--d);
  }
  .sk-logo.is-compact .sk-logo__s { transform: translate(-717.69px, -281.46px) scale(2.1332); }
  .sk-logo.is-compact .sk-logo__k { transform: translate(-2404.46px, -291.52px) scale(2.2615); }
  .sk-logo.is-compact .sk-logo__s,
  .sk-logo.is-compact .sk-logo__k {
    opacity: 0;
    transition: transform .6s var(--ease) .18s, opacity .25s ease .62s;
  }
  .sk-logo.is-compact .sk-logo__mono {
    opacity: 1;
    transform: none;
    transition: opacity .3s ease .55s, transform .45s var(--ease) .55s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sk-logo, .sk-logo * { transition: none !important; }
  }
</style>

<script>
  // Wechselt beim Scrollen zwischen vollem Schriftzug und SK.
  // data-trigger="scroll" (Standard) | "load" (einmal nach dem Laden) | "none" (per Klasse steuern)
  document.querySelectorAll('[data-sk-logo]').forEach((el) => {
    const trigger = el.dataset.trigger || 'scroll';
    if (trigger === 'load') {
      setTimeout(() => el.classList.add('is-compact'), Number(el.dataset.delay || 1200));
      return;
    }
    if (trigger !== 'scroll') return;
    const down = Number(el.dataset.offset || 80), up = Math.max(0, down - 60);
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      if (y > down) el.classList.add('is-compact');
      else if (y < up) el.classList.remove('is-compact');
      ticking = false;
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  });
</script>
