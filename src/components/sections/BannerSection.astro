---
import type {Link, SiteImage} from '../../lib/content'
import ArrowLink from '../ArrowLink.astro'
import Img from '../Img.astro'

interface Props {
  heading?: string
  lead?: string
  link?: Link
  align?: 'left' | 'center'
  backgroundImage?: SiteImage
  backgroundVideo?: string
}

const {heading, lead, link, align = 'left', backgroundImage, backgroundVideo} = Astro.props
---

<!-- Teaser über die volle Breite: Bild oder Video, abgedunkelt, darauf Überschrift, Text und Link -->
<section data-tone="dark" class="theme-dark relative flex min-h-[26rem] items-center overflow-hidden py-24 lg:min-h-[41vw]">
  {
    backgroundVideo ? (
      <video
        class="absolute inset-0 h-full w-full object-cover"
        src={backgroundVideo}
        poster={backgroundImage?.url}
        autoplay
        muted
        loop
        playsinline
        aria-hidden="true"
      />
    ) : (
      backgroundImage && <Img image={backgroundImage} class="absolute inset-0 h-full w-full object-cover" />
    )
  }
  <div class="absolute inset-0 bg-ink/45"></div>

  <div class="relative container">
    <div class:list={[align === 'center' ? 'mx-auto max-w-3xl text-center' : 'max-w-xl']}>
      {heading && <h2 data-reveal>{heading}</h2>}
      {lead && <p class="mt-4 text-lead" data-reveal>{lead}</p>}
      <ArrowLink link={link} />
    </div>
  </div>
</section>
