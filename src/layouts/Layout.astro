---
import '../styles/global.css'
// Gleiche Datei wie im CSS (gleicher Hash), hier nur zum Vorladen
import fontUrl from '@fontsource-variable/nunito-sans/files/nunito-sans-latin-wght-normal.woff2?url'
import ContactPanel from '../components/ContactPanel.astro'
import CookieConsent from '../components/CookieConsent.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import {getContent, type Settings, type SiteImage} from '../lib/content'
import {smoothScrollLerp} from '../lib/smoothScroll'

interface Props {
  settings: Settings
  title?: string
  description?: string
  headerTone: 'light' | 'dark'
  anchors?: {id: string; label: string}[]
  /** Vorschaubild beim Teilen (Kopfbild der Seite); sonst das der Startseite */
  image?: SiteImage
}

const {settings, title, description = settings.description, headerTone, anchors, image} = Astro.props
const {consent, pages} = await getContent()
const lerp = smoothScrollLerp(settings.smoothScroll)
const fullTitle = title ? `${title} – ${settings.title}` : settings.title
// Vorschaubild für WhatsApp, LinkedIn & Co.: 1200 × 630, aus dem Sanity-CDN zugeschnitten (absolute Adresse)
const shareImage = image ?? pages.find((page) => page.slug === 'home')?.hero?.image
const ogImage = shareImage?.kind === 'sanity' ? `${shareImage.url}?w=1200&h=630&fit=crop&auto=format&q=80` : undefined
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.title} />
    <meta property="og:locale" content="de_DE" />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <!-- favicon.ico für ältere Browser und Suchmaschinen, SVG (passt sich dem dunklen Design an) für alle anderen -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Schrift sofort mitladen statt erst nach dem CSS: verhindert, dass die Seite kurz in Systemschrift erscheint -->
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <!-- Vor dem ersten Rendern setzen, damit einzublendende Elemente nicht kurz aufblitzen -->
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body data-smooth-lerp={lerp}>
    <a href="#inhalt" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:p-3 focus:text-ink">
      Zum Inhalt springen
    </a>
    <Header settings={settings} tone={headerTone} anchors={anchors} />
    <main id="inhalt">
      <slot />
    </main>
    <Footer settings={settings} />
    {settings.contactPanel && <ContactPanel panel={settings.contactPanel} />}
    <CookieConsent consent={consent} />

    <script>
      import Lenis from 'lenis'

      // Smooth-Scrolling für Mausrad und Trackpad, Stärke aus den Website-Einstellungen (0 = aus).
      // Touch bleibt nativ; aus bei „Bewegung reduzieren“.
      const lerp = Number(document.body.dataset.smoothLerp)
      if (lerp > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({lerp, smoothWheel: true, syncTouch: false})
        const raf = (time: number) => {
          lenis.raf(time)
          requestAnimationFrame(raf)
        }
        requestAnimationFrame(raf)

        // Kontakt-Panel und mobiles Menü sperren die Seite über die Klasse overflow-hidden: dann anhalten
        new MutationObserver(() =>
          document.documentElement.classList.contains('overflow-hidden') ? lenis.stop() : lenis.start(),
        ).observe(document.documentElement, {attributes: true, attributeFilter: ['class']})

        // Anker auf derselben Seite weich anfahren; Lenis beachtet dabei scroll-margin-top (Abstand unter dem Header)
        document.addEventListener('click', (event) => {
          if (event.defaultPrevented) return
          const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href*="#"]')
          if (!link) return
          const url = new URL(link.href, location.href)
          if (url.pathname !== location.pathname || !url.hash || url.hash === '#kontakt') return
          const target = document.getElementById(decodeURIComponent(url.hash.slice(1)))
          if (!target) return
          event.preventDefault()
          lenis.scrollTo(target)
          history.pushState(null, '', url.hash)
        })
      }
    </script>

    <script>
      // Alle Videos (Kopfbereich, Banner, Freie Fläche): laden, sobald sie in die Nähe kommen, abspielen nur solange sichtbar.
      // Bei „Bewegung reduzieren“ bleibt das Vorschaubild stehen (bzw. das erste Bild des Videos).
      const videos = [...document.querySelectorAll<HTMLVideoElement>('[data-lazy-video]')]
      if (videos.length) {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)')
        const load = (video: HTMLVideoElement) => {
          if (!video.src && video.dataset.src) {
            video.src = video.dataset.src
            if (reduce.matches && !video.poster) video.preload = 'metadata'
          }
        }
        const nearby = new IntersectionObserver(
          (entries) => entries.forEach((entry) => entry.isIntersecting && (load(entry.target as HTMLVideoElement), nearby.unobserve(entry.target))),
          {rootMargin: '400px 0px'},
        )
        const visible = new IntersectionObserver((entries) =>
          entries.forEach((entry) => {
            const video = entry.target as HTMLVideoElement
            if (entry.isIntersecting && !reduce.matches) {
              load(video)
              video.play().catch(() => {})
            } else video.pause()
          }),
        )
        videos.forEach((video) => {
          nearby.observe(video)
          visible.observe(video)
        })
        reduce.addEventListener('change', () => videos.forEach((video) => reduce.matches && video.pause()))
      }
    </script>

    <script>
      // Blendet Elemente mit data-reveal ein, sobald ihr oberer Rand 15 % über dem unteren Fensterrand liegt.
      // Was gleichzeitig ins Bild kommt, erscheint in Lesereihenfolge um je 100 ms versetzt (höchstens 5 Stufen).
      const STEP = 100
      const MAX_STEPS = 5
      const observer = new IntersectionObserver(
        (entries) => {
          entries
            .filter((entry) => entry.isIntersecting)
            .map((entry) => ({el: entry.target as HTMLElement, rect: entry.boundingClientRect}))
            .sort((a, b) => a.rect.top - b.rect.top || a.rect.left - b.rect.left)
            .forEach(({el}, i) => {
              el.style.transitionDelay = `${Math.min(i, MAX_STEPS) * STEP}ms`
              el.classList.add('is-visible')
              observer.unobserve(el)
            })
        },
        {rootMargin: '0px 0px -15% 0px'},
      )
      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el))
    </script>
  </body>
</html>
