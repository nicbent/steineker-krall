// Cloudflare Workers: liefert nur den statischen Astro-Build aus dist/ aus (kein Server-Code)
{
  "name": "steineker-krall",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Unbekannte Adressen: dist/404.html mit Status 404
    "not_found_handling": "404-page"
  }
}
